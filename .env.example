# Read-only scanning; never supply a wallet private key to this scanner.
RPC_URL=https://mainnet.base.org
SIZES_ETH=0.05,0.5,2
MAX_QUOTE_AGE_BLOCKS=2
SCAN_TOKENS_PER_BLOCK=1
PROFIT_BUFFER_ETH=0
