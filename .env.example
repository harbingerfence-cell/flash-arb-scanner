# Read-only scanning; never supply a wallet private key to this scanner.
RPC_URL=https://mainnet.base.org
SIZES_ETH=0.05,0.5,2
MAX_QUOTE_AGE_BLOCKS=2
SCAN_TOKENS_PER_BLOCK=1
PROFIT_BUFFER_ETH=0
# Fraction of borrowed amount; verify your lender's current fee.
FLASH_FEE=0
# Fallback estimates used for quote ranking only.
ARB_GAS_UNITS=350000
L1_FEE_ETH=0.000005
CSV_PATH=results/opportunities-v2.csv
# Optional deployed FlashArb contract. No transaction is broadcast.
EXECUTOR_ADDRESS=
SIMULATE_TOP=3
GAS_BUFFER_BPS=2000

# All 50 centralized exchanges: public spot books, monitoring only.
CEX_ENABLED=1
CEX_POLL_MS=60000
CEX_TIMEOUT_MS=10000
CEX_CONCURRENCY=8
CEX_MAX_AGE_MS=20000
CEX_MAX_SKEW_MS=5000
CEX_BASE_SIZES={"BTC":[0.001,0.01],"ETH":[0.05,0.5]}
# Account-specific taker fees in basis points, keyed by scanner/exchanges.js IDs.
# Missing fees mean net is UNKNOWN, never assumed zero.
CEX_TAKER_FEES_BPS={}
CEX_CSV_PATH=results/cex-observations.csv
