/* SPDX-License-Identifier: MIT */ pragma solidity ^0.8.24; import {FlashArb, IBalancerVault, IV3Router} from "../src/FlashArb.sol"; interface Vm { function deal(address who, uint256 amount) external; function prank(address who) external; } interface IWETH { function deposit() external payable; function balanceOf(address) external view returns (uint256); function approve(address, uint256) external returns (bool); } contract FlashArbForkTest { Vm constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code"))))); address constant VAULT = 0xBA12222222228d8Ba445958a75a0704d566BF2C8; address constant WETH = 0x4200000000000000000000000000000000000006; address constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913; address constant UNI_ROUTER = 0x2626664c2603336E57B271c5C0b26F421741e481; address constant PANCAKE_ROUTER = 0x678Aa4bF4E210cf2166753e054d5b7c31cc7fa86; address constant AERO_ROUTER = 0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5; event log_named_uint(string key, uint256 val); FlashArb arb; function setUp() public { arb = new FlashArb(VAULT, WETH, UNI_ROUTER, PANCAKE_ROUTER, AERO_ROUTER); } function _route(FlashArb.Dex buyDex, uint24 buyFee, FlashArb.Dex sellDex, uint24 sellFee) internal pure returns (FlashArb.Route memory) { return FlashArb.Route(USDC, FlashArb.Leg(buyDex, buyFee), FlashArb.Leg(sellDex, sellFee)); } function _simulate(FlashArb.Route memory r, uint256 amount) internal returns (uint256 out, uint256 owed) { try arb.execute(r, amount, 0, true) { revert("simulate did not revert"); } catch (bytes memory err) { require(bytes4(err) == FlashArb.SimResult.selector, _why(err)); assembly { out := mload(add(err, 36)) owed := mload(add(err, 68)) } } } function _why(bytes memory err) internal pure returns (string memory) { if (err.length < 4) return "reverted with no reason (bad router address or no pool?)"; return string(abi.encodePacked("unexpected revert, selector 0x", _hex(bytes4(err)))); } function _hex(bytes4 b) internal pure returns (string memory s) { bytes memory h = "0123456789abcdef"; bytes memory o = new bytes(8); for (uint256 i = 0; i < 4; i++) { o[2 * i] = h[uint8(b[i]) >> 4]; o[2 * i + 1] = h[uint8(b[i]) & 15]; } s = string(o); } function test_simulate_uniswap_to_pancake() public { (uint256 out, uint256 owed) = _simulate(_route(FlashArb.Dex.UniswapV3, 500, FlashArb.Dex.PancakeV3, 100), 1 ether); emit log_named_uint("out (wei)", out); emit log_named_uint("owed (wei)", owed); require(owed >= 1 ether && owed <= 1.001 ether, "unexpected flash loan fee"); require(out > 0.99 ether && out < 1.01 ether, "round trip result out of range"); } function test_simulate_uniswap_to_aerodrome() public { (uint256 out,) = _simulate(_route(FlashArb.Dex.UniswapV3, 500, FlashArb.Dex.AerodromeCL, 100), 1 ether); emit log_named_uint("out via Aerodrome (wei)", out); require(out > 0.99 ether && out < 1.01 ether, "round trip result out of range"); } function test_unprofitable_reverts() public { try arb.execute(_route(FlashArb.Dex.UniswapV3, 500, FlashArb.Dex.PancakeV3, 100), 1 ether, 1, false) { revert("should have reverted"); } catch (bytes memory err) { require(bytes4(err) == FlashArb.NoProfit.selector, _why(err)); } } function test_profitable_when_gap_exists() public { vm.deal(address(this), 100 ether); IWETH(WETH).deposit{value: 100 ether}(); IWETH(WETH).approve(PANCAKE_ROUTER, 100 ether); IV3Router(PANCAKE_ROUTER).exactInputSingle(IV3Router.Params(WETH, USDC, 100, address(this), 100 ether, 0, 0)); uint256 before = IWETH(WETH).balanceOf(address(this)); arb.execute(_route(FlashArb.Dex.UniswapV3, 500, FlashArb.Dex.PancakeV3, 100), 1 ether, 1, false); uint256 profit = IWETH(WETH).balanceOf(address(this)) - before; emit log_named_uint("profit (wei)", profit); require(profit > 0, "no profit"); require(IWETH(WETH).balanceOf(address(arb)) == 0, "contract kept funds"); } function test_only_owner_can_execute() public { vm.prank(address(0xBEEF)); try arb.execute(_route(FlashArb.Dex.UniswapV3, 500, FlashArb.Dex.PancakeV3, 100), 1 ether, 0, false) { revert("stranger executed"); } catch (bytes memory err) { require(bytes4(err) == FlashArb.NotOwner.selector, _why(err)); } } function test_outside_flash_loan_rejected() public { address[] memory t = new address[](1); t[0] = WETH; uint256[] memory a = new uint256[](1); a[0] = 1 ether; try IBalancerVault(VAULT).flashLoan(address(arb), t, a, "") { revert("outside flash loan accepted"); } catch (bytes memory err) { require(bytes4(err) == FlashArb.NotInFlight.selector, _why(err)); } } receive() external payable {} }
