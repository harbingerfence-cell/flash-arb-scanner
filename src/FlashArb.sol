/* SPDX-License-Identifier: MIT */ pragma solidity ^0.8.24; interface IERC20 { function balanceOf(address) external view returns (uint256); function transfer(address, uint256) external returns (bool); } interface IBalancerVault { function flashLoan(address recipient, address[] calldata tokens, uint256[] calldata amounts, bytes calldata userData) external; } interface IV3Router { struct Params { address tokenIn; address tokenOut; uint24 fee; address recipient; uint256 amountIn; uint256 amountOutMinimum; uint160 sqrtPriceLimitX96; } function exactInputSingle(Params calldata p) external payable returns (uint256); } interface ICLRouter { struct Params { address tokenIn; address tokenOut; int24 tickSpacing; address recipient; uint256 deadline; uint256 amountIn; uint256 amountOutMinimum; uint160 sqrtPriceLimitX96; } function exactInputSingle(Params calldata p) external payable returns (uint256); } contract FlashArb { enum Dex { UniswapV3, PancakeV3, AerodromeCL } struct Leg { Dex dex; uint24 feeOrTickSpacing; } struct Route { address token; Leg buy; Leg sell; } error NotOwner(); error NotVault(); error NotInFlight(); error NoProfit(uint256 out, uint256 owed); error SimResult(uint256 out, uint256 owed); error ApproveFailed(); event Arb(address indexed token, uint256 amount, uint256 profit); address public immutable owner; IBalancerVault public immutable vault; address public immutable weth; address public immutable uniRouter; address public immutable pancakeRouter; address public immutable aeroRouter; bool private inFlight; constructor(address _vault, address _weth, address _uni, address _pancake, address _aero) { owner = msg.sender; vault = IBalancerVault(_vault); weth = _weth; uniRouter = _uni; pancakeRouter = _pancake; aeroRouter = _aero; } function execute(Route calldata r, uint256 amount, uint256 minProfit, bool simulate) external { if (msg.sender != owner) revert NotOwner(); inFlight = true; address[] memory tokens = new address[](1); tokens[0] = weth; uint256[] memory amounts = new uint256[](1); amounts[0] = amount; vault.flashLoan(address(this), tokens, amounts, abi.encode(r, minProfit, simulate)); inFlight = false; } function receiveFlashLoan(address[] calldata, uint256[] calldata amounts, uint256[] calldata fees, bytes calldata data) external { if (msg.sender != address(vault)) revert NotVault(); if (!inFlight) revert NotInFlight(); (Route memory r, uint256 minProfit, bool simulate) = abi.decode(data, (Route, uint256, bool)); uint256 amount = amounts[0]; uint256 owed = amount + fees[0]; uint256 got = _swap(r.buy, weth, r.token, amount); uint256 out = _swap(r.sell, r.token, weth, got); if (simulate) revert SimResult(out, owed); if (out < owed + minProfit) revert NoProfit(out, owed); IERC20(weth).transfer(address(vault), owed); uint256 profit = out - owed; IERC20(weth).transfer(owner, profit); emit Arb(r.token, amount, profit); } function _swap(Leg memory leg, address tokenIn, address tokenOut, uint256 amountIn) internal returns (uint256) { if (leg.dex == Dex.AerodromeCL) { _approve(tokenIn, aeroRouter, amountIn); return ICLRouter(aeroRouter).exactInputSingle(ICLRouter.Params( tokenIn, tokenOut, int24(uint24(leg.feeOrTickSpacing)), address(this), block.timestamp, amountIn, 0, 0)); } address router = leg.dex == Dex.UniswapV3 ? uniRouter : pancakeRouter; _approve(tokenIn, router, amountIn); return IV3Router(router).exactInputSingle(IV3Router.Params(tokenIn, tokenOut, leg.feeOrTickSpacing, address(this), amountIn, 0, 0)); } function _approve(address token, address spender, uint256 amount) internal { (bool ok, bytes memory ret) = token.call(abi.encodeWithSelector(0x095ea7b3, spender, amount)); if (!ok || (ret.length > 0 && !abi.decode(ret, (bool)))) revert ApproveFailed(); } function withdraw(address token, uint256 amount) external { if (msg.sender != owner) revert NotOwner(); if (token == address(0)) payable(owner).transfer(amount); else IERC20(token).transfer(owner, amount); } receive() external payable {} }
